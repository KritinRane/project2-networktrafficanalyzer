# ── NerdsToGo Network Analyzer — environment configuration ───────────────
# Copy this file to `.env` and fill in your values:  cp .env.example .env
# The app loads .env automatically at startup. Never commit your real .env.

# ── Required ─────────────────────────────────────────────────────────────
# Groq API key — powers the AI customer summary. Free tier works.
# Get one at https://console.groq.com
GROQ_API_KEY=

# ── Admin login & security ───────────────────────────────────────────────
# Credentials for the technician (admin) login. CHANGE THESE.
APP_USERNAME=admin
APP_PASSWORD=change-me

# Signs login sessions. Set a long random value in production, e.g.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login session stays valid (hours).
TOKEN_EXPIRE_HOURS=12

# Where the SQLite database file lives.
DB_PATH=data/app.db

# ── Email delivery (needed only to email client reports) ─────────────────
# Leave blank to disable email. For Gmail, SMTP_PASS must be a 16-character
# App Password (not your normal account password).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_NAME=NerdsToGo

# The public URL clients use to open their portal. MUST be your real domain
# in production, or invite links will point at localhost.
PUBLIC_BASE_URL=http://localhost:8000

# ── Live capture (optional, macOS-first) ─────────────────────────────────
# Only needed to capture/scan from this machine instead of uploading files.
# Path to Wireshark's dumpcap binary, if it isn't on your PATH.
DUMPCAP=
# Path to Angry IP Scanner.app, if it isn't in a standard Applications folder.
IPSCAN_APP=
